---
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '../styles/global.css';
import pt from '../data/resume.json';
import en from '../data/resume.en.json';
import { UI } from '../lib/i18n.mjs';

// page: caminho relativo à raiz de cada idioma ('' para a página inicial, 'erp/' para a galeria).
const {
  lang = 'pt',
  title: pageTitle,
  description: pageDescription,
  page = '',
  noindex = false,
} = Astro.props as { lang?: 'pt' | 'en'; title?: string; description?: string; page?: string; noindex?: boolean };
const resume = lang === 'en' ? en : pt;
const t = UI[lang];
const { person, meta } = resume;
const title = pageTitle ?? `${person.fullName} | ${t.title}`;
const description = pageDescription ?? `${person.tagline} ${person.headline}.`;
const url = (path: string) => new URL(path, meta.siteUrl).href;
// Dados estruturados: bloco de dados, não é executado, então a CSP sem scripts continua valendo.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.fullName,
  url: url(t.path),
  image: url('/foto/ryan-lucas-800.webp'),
  description,
  email: `mailto:${resume.contact.email}`,
  sameAs: resume.contact.links.map((link) => link.url),
  alumniOf: resume.education.map((item) => ({ '@type': 'CollegeOrUniversity', name: item.school })),
}).replace(/</g, () => String.fromCharCode(92) + 'u003c'); // impede fechar a tag script
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={url(t.path + page)} />
          <link rel="alternate" hreflang="pt-BR" href={url(UI.pt.path + page)} />
          <link rel="alternate" hreflang="en" href={url(UI.en.path + page)} />
          <link rel="alternate" hreflang="x-default" href={url(UI.pt.path + page)} />
          <link rel="sitemap" href="/sitemap.xml" />
          {page === '' && <script type="application/ld+json" is:inline set:html={jsonLd} />}
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(t.path + page)} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:image" content={url('/generated/og.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t.skip}</a>
    <slot />
  </body>
</html>
