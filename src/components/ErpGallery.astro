---
import Base from '../layouts/Base.astro';
import gallery from '../data/erp-gallery.json';
import { UI } from '../lib/i18n.mjs';

type Item = { slug: string; title: string; text: string };
type Group = { title?: string; items: Item[] };
type Section = { id: string; title: string; intro: string; layout: 'desktop' | 'phone'; groups: Group[] };

const { lang } = Astro.props as { lang: 'pt' | 'en' };
const t = UI[lang];
const g = gallery[lang];
const sections = g.sections as Section[];
const sizes = gallery.sizes as Record<string, [number, number]>;
const src = (slug: string, width: number) => `/erp/${slug}-${width}.webp`;
const count = (section: Section) => section.groups.reduce((sum, group) => sum + group.items.length, 0);
// Em grupos com número ímpar de telas, a primeira ocupa a largura toda e a grade fecha sem buraco.
const wide = (group: Group, i: number) => group.items.length % 2 === 1 && i === 0;
let first = true;
const eager = () => {
  const value = first;
  first = false;
  return value;
};
---

<Base lang={lang} title={`${g.title} | Ryan Lucas`} description={g.intro} page="erp/">
  <header class="frame pt-5">
    <nav class="flex items-baseline justify-between text-small" aria-label={t.navLabel}>
      <a class="text-link font-medium" href={t.path}>{g.back}</a>
      <a class="text-link" href={`${t.switch.href}erp/`} hreflang={t.switch.lang} lang={t.switch.lang} aria-label={t.switch.aria}>
        {t.switch.label}
      </a>
    </nav>
    <h1 class="mt-16 max-w-[16ch] text-head leading-[0.95] font-medium tracking-[-0.05em]">{g.title}</h1>
    <p class="mt-6 max-w-[52ch] text-lead leading-snug">{g.intro}</p>
    <nav class="mt-10 grid gap-2 sm:max-w-2xl sm:grid-cols-2" aria-label={g.jump}>
      {
        sections.map((section) => (
          <a href={`#${section.id}`} class="flex items-baseline justify-between gap-4 bg-surface px-5 py-4 hover:text-accent">
            <span class="text-lead leading-none font-medium tracking-tight">{section.title}</span>
            <span class="text-small text-muted">
              {count(section)} {g.screens}
            </span>
          </a>
        ))
      }
    </nav>
  </header>

  <main id="conteudo">
    {
      sections.map((section) => (
        <section id={section.id} class="frame section pb-0! scroll-mt-4" aria-labelledby={`${section.id}-titulo`}>
          <h2 id={`${section.id}-titulo`}>{section.title}</h2>
          <p class="mt-6 max-w-[56ch] text-lead leading-snug">{section.intro}</p>

          {section.layout === 'desktop' ? (
            section.groups.map((group) => (
              <div class="mt-16">
                {group.title && <h3 class="mb-6 border-t border-edge pt-4 text-small font-medium text-muted">{group.title}</h3>}
                <div class="grid gap-x-6 gap-y-12 lg:grid-cols-2">
                  {group.items.map((item, i) => {
                    const [width, height] = sizes[item.slug];
                    return (
                      <figure class:list={['flex flex-col gap-4', wide(group, i) && 'lg:col-span-2']}>
                        <a href={src(item.slug, 1568)} class="block bg-surface p-2" aria-label={`${g.open}: ${item.title}`}>
                          <img
                            src={src(item.slug, 1568)}
                            srcset={`${src(item.slug, 800)} 800w, ${src(item.slug, 1568)} 1568w`}
                            sizes={wide(group, i) ? '100vw' : '(min-width: 64rem) 50vw, 100vw'}
                            width={width}
                            height={height}
                            loading={eager() ? 'eager' : 'lazy'}
                            decoding="async"
                            class="h-auto w-full"
                            alt={item.title}
                          />
                        </a>
                        <figcaption class:list={[wide(group, i) && 'lg:grid lg:grid-cols-[1fr_2fr] lg:gap-6']}>
                          <h4 class="text-[clamp(1.25rem,1.8vw,1.5rem)] leading-tight font-medium tracking-tight">{item.title}</h4>
                          <p class="mt-2 max-w-[62ch] text-small text-body lg:mt-0">{item.text}</p>
                        </figcaption>
                      </figure>
                    );
                  })}
                </div>
              </div>
            ))
          ) : (
            <div class="mt-16 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:grid-cols-4">
              {section.groups.flatMap((group) =>
                group.items.map((item) => {
                  const [width, height] = sizes[item.slug];
                  return (
                    <figure class="flex flex-col gap-4">
                      <a href={src(item.slug, width)} class="block bg-surface p-2" aria-label={`${g.open}: ${item.title}`}>
                        <span class="block aspect-[455/726] overflow-hidden">
                          <img
                            src={src(item.slug, width)}
                            width={width}
                            height={height}
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover object-top"
                            alt={item.title}
                          />
                        </span>
                      </a>
                      <figcaption>
                        <h3 class="text-[clamp(1.0625rem,1.6vw,1.25rem)] leading-tight font-medium tracking-tight">{item.title}</h3>
                        <p class="mt-2 text-small text-body">{item.text}</p>
                      </figcaption>
                    </figure>
                  );
                }),
              )}
            </div>
          )}
        </section>
      ))
    }
    <p class="frame section"><a class="text-link" href={t.path}>{g.back}</a></p>
  </main>
</Base>
