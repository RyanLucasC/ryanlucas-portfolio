---
import StatusBadge from './StatusBadge.astro';
import TagList from './TagList.astro';
import { UI } from '../lib/i18n.mjs';

const { project, lang = 'pt' } = Astro.props;
const home = UI[lang as 'pt' | 'en'].path;
---

<article class="rise flex h-full flex-col gap-5 bg-surface p-6 md:p-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-[clamp(2rem,3.6vw,3.25rem)] leading-none tracking-tight">{project.name}</h3>
      <p class="mt-2 text-small text-muted">{project.context}</p>
    </div>
    <StatusBadge status={project.status} lang={lang} />
  </div>
  <p class="max-w-[62ch] text-ink">{project.summary}</p>
  <ul class="list-disc space-y-1.5 pl-5 text-body marker:text-accent">
    {project.highlights.map((item: string) => <li>{item}</li>)}
  </ul>
  <figure data-ui class="mt-auto bg-canvas p-4 text-small">
    <figcaption class="mb-3 text-muted">{project.architectureTitle}</figcaption>
    <ol class="space-y-1">
      {
        project.architecture.map((tier: { layer: string; items: string[] }) => (
          <li class="grid grid-cols-[6rem_1fr] items-baseline gap-3 bg-surface px-3 py-2">
            <span class="text-muted">{tier.layer}</span>
            <span class="text-ink">{tier.items.join(' · ')}</span>
          </li>
        ))
      }
    </ol>
  </figure>
  <TagList tags={project.tags} />
  {
    (project.gallery || project.link) && (
      <p class="flex flex-wrap gap-x-6 gap-y-2">
        {project.gallery && (
          <a class="text-link font-medium" href={home + project.gallery.page}>
            {project.gallery.label}
          </a>
        )}
        {project.link && (
          <a class="text-link" href={project.link.url} target="_blank" rel="noopener noreferrer">
            {project.link.label}
          </a>
        )}
      </p>
    )
  }
</article>
