---
import Base from '../layouts/Base.astro';
import AsciiSky from './AsciiSky.astro';
import DataTable from './DataTable.astro';
import KanbanBoard from './KanbanBoard.astro';
import ProjectCard from './ProjectCard.astro';
import StatusBadge from './StatusBadge.astro';
import TagList from './TagList.astro';
import pt from '../data/resume.json';
import en from '../data/resume.en.json';
import { UI } from '../lib/i18n.mjs';
import { contentUpdatedAt } from '../lib/updated.mjs';
import manifest from '../../public/generated/manifest.json';

const { lang } = Astro.props as { lang: 'pt' | 'en' };
const resume = lang === 'en' ? en : pt;
const t = UI[lang];
const { person, contact, about, stack, projects, experience, goals, certifications, roadmap, meta } = resume;
const [firstLine, secondLine] = ['RYAN LUCAS', 'CARDOSO'];
const pdfHref = `/${meta.pdfFile}`;
const pdfSize = `${Math.round(manifest[lang].pdfBytes / 1024)} KB`;
const preview = manifest[lang].pages[0];
const updated = new Intl.DateTimeFormat(t.htmlLang, { month: 'short', year: 'numeric', timeZone: 'America/Sao_Paulo' }).format(contentUpdatedAt());
const contactRows = [
  { label: t.email, handle: contact.email, url: `mailto:${contact.email}`, external: false },
  ...contact.links.map((link) => ({ ...link, external: true })),
];
const nav = [
  { label: t.nav.projects, href: '#projetos' },
  { label: t.nav.experience, href: '#experiencia' },
  { label: t.nav.roadmap, href: '#roadmap', wide: true },
  { label: t.nav.contact, href: '#contato' },
];
---

<Base lang={lang}>
  <header class="frame flex flex-col pt-5 pb-6 lg:min-h-svh">
    <nav class="flex items-baseline justify-between text-small" aria-label={t.navLabel}>
      <span class="font-medium">Ryan Lucas</span>
      <ul class="flex gap-4 sm:gap-6">
        {nav.map((item) => <li class:list={[item.wide && 'hidden sm:block']}><a class="text-link" href={item.href}>{item.label}</a></li>)}
        <li><a class="text-link" href={t.switch.href} hreflang={t.switch.lang} lang={t.switch.lang} aria-label={t.switch.aria}>{t.switch.label}</a></li>
      </ul>
    </nav>

    <h1 aria-label={person.displayName} class="mt-[9svh] text-display leading-[0.9] font-medium tracking-[-0.05em]">
      <span class="line block overflow-hidden pb-[0.04em]" aria-hidden="true"><span class="block">{firstLine}</span></span>
      <span class="line block overflow-hidden pb-[0.04em] md:text-right" aria-hidden="true"><span class="block">{secondLine}</span></span>
    </h1>

    <div class="hero-foot mt-auto flex flex-col gap-6 pt-12 md:flex-row md:items-end md:justify-between">
      <div class="max-w-[46ch]">
        <p class="text-lead leading-tight font-medium tracking-tight">{person.headline}</p>
        <p class="mt-3 text-body">{person.tagline}</p>
        <p class="mt-1 font-medium text-accent">{person.seeking}</p>
      </div>
      <a
        href={pdfHref}
        download
        class="bg-accent px-6 py-4 text-center font-medium whitespace-nowrap text-canvas hover:bg-ink active:translate-y-px md:ml-auto"
      >
        {t.download} (PDF, {pdfSize})
      </a>
    </div>
  </header>

  <main id="conteudo">
    <section id="sobre" class="frame section grid items-stretch gap-10 md:grid-cols-[2fr_3fr] lg:gap-16" aria-labelledby="sobre-titulo">
      <img
        class="rise h-auto w-full object-cover object-top md:h-full"
        src="/foto/ryan-lucas-800.webp"
        srcset="/foto/ryan-lucas-480.webp 480w, /foto/ryan-lucas-800.webp 800w"
        sizes="(min-width: 48rem) 40vw, 100vw"
        width="800"
        height="1000"
        alt={t.photoAlt}
      />
      <div class="rise flex flex-col">
        <h2 id="sobre-titulo">{t.about}</h2>
        <div class="mt-8 space-y-4 text-lead leading-snug tracking-tight">
          {about.summary.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <dl class="mt-auto grid grid-cols-2 gap-5 pt-10 text-small lg:grid-cols-3">
          {
            about.facts.map((fact) => (
              <div>
                <dt class="text-muted">{fact.label}</dt>
                <dd class="text-ink">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section id="projetos" class="frame section" aria-labelledby="projetos-titulo">
      <h2 id="projetos-titulo" class="rise mb-10">{t.projects}</h2>
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-3">
        {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
      </div>
    </section>

    <section id="experiencia" class="frame section pt-0!" aria-labelledby="experiencia-titulo">
      <h2 id="experiencia-titulo" class="rise mb-10">{t.experience}</h2>
      <div class="rise">
        <DataTable headers={t.experienceHeaders}>
          {
            experience.map((job) => (
              <tr>
                <td class="whitespace-nowrap">{job.period}</td>
                <th scope="row">
                  {job.role}
                  <span class="mt-1 block font-normal text-body">{job.company}</span>
                </th>
                <td>
                  <ul class="list-disc space-y-1 pl-4 text-body marker:text-accent">
                    {job.highlights.map((item) => <li>{item}</li>)}
                  </ul>
                </td>
              </tr>
            ))
          }
        </DataTable>
      </div>
    </section>

    <section id="stack" class="section frame bg-surface pb-0!" aria-labelledby="stack-titulo">
      <div class="grid gap-8 lg:grid-cols-[1fr_2fr]">
        <h2 id="stack-titulo" class="rise">Tech Stack</h2>
        <div class="rise">
          <DataTable headers={t.stackHeaders}>
            {
              stack.map((row) => (
                <tr>
                  <th scope="row">{row.group}</th>
                  <td><TagList tags={row.items} /></td>
                </tr>
              ))
            }
          </DataTable>
        </div>
      </div>
    </section>

    <section id="objetivos" class="section frame bg-surface" aria-labelledby="objetivos-titulo">
      <h2 id="objetivos-titulo" class="rise mb-10">{t.goals}</h2>
      <KanbanBoard items={goals} lang={lang} />
    </section>

    <section id="roadmap" class="frame section" aria-labelledby="roadmap-titulo">
      <h2 id="roadmap-titulo" class="rise mb-10">Roadmap</h2>
      <div class="grid gap-12 lg:grid-cols-[2fr_1fr]">
        <div class="rise">
          <DataTable caption={t.studyPath} headers={t.studyHeaders}>
            {
              roadmap.map((row) => (
                <tr>
                  <th scope="row" class="whitespace-nowrap">{row.phase}</th>
                  <td class="text-ink!">{row.topic}</td>
                  <td>{row.courses.join(' · ')}</td>
                  <td class="cell-end"><StatusBadge status={row.status} lang={lang} /></td>
                </tr>
              ))
            }
          </DataTable>
        </div>
        <div class="rise">
          <DataTable caption={t.certifications} headers={t.certificationHeaders}>
            {
              certifications.map((row) => (
                <tr>
                  <th scope="row">{row.name}</th>
                  <td class="cell-end"><StatusBadge status={row.status} lang={lang} /></td>
                </tr>
              ))
            }
          </DataTable>
        </div>
      </div>
    </section>

    <section id="curriculo" class="section frame grid items-center gap-10 bg-surface md:grid-cols-[3fr_2fr]" aria-labelledby="curriculo-titulo">
      <div>
        <h2 id="curriculo-titulo" class="rise">{t.resume}</h2>
        <p class="rise mt-6 max-w-[42ch] text-lead leading-snug">{t.resumeText}</p>
        <a
          href={pdfHref}
          download
          class="rise mt-8 inline-block bg-accent px-6 py-4 font-medium text-canvas hover:bg-ink active:translate-y-px"
        >
          {t.download} (PDF, {pdfSize})
        </a>
      </div>
      <a href={pdfHref} download class="rise block" aria-label={`${t.download} (PDF, ${pdfSize})`}>
        <img
          src={preview.file}
          width={preview.width}
          height={preview.height}
          loading="lazy"
          decoding="async"
          class="h-auto w-full"
          alt={t.resumeAlt}
        />
      </a>
    </section>

    <AsciiSky />
  </main>

  <footer id="contato" class="overflow-hidden bg-accent text-canvas">
    <div class="frame pt-[clamp(4.5rem,11vw,10rem)]">
      <h2 class="max-w-[17em] text-[clamp(1.75rem,6vw,5.5rem)]!">{contact.availability}</h2>
      <ul class="mt-10 space-y-1">
        {
          contactRows.map((link) => (
            <li>
              <a
                href={link.url}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="flex flex-wrap items-baseline justify-between gap-x-6 bg-canvas px-5 py-4 text-ink hover:bg-surface hover:text-accent active:translate-y-px md:px-7 md:py-6"
              >
                <span class="text-[clamp(1.75rem,4.4vw,4rem)] leading-none font-medium tracking-tight">{link.label}</span>
                <span class="text-body">{link.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-wrap justify-between gap-x-6 gap-y-1 text-small font-medium">
        <p>{person.fullName}</p>
        <p>{t.updated} {updated}</p>
        <p>{person.footer}</p>
      </div>
    </div>
    <p aria-hidden="true" class="mt-4 -mb-[0.26em] pl-[2vw] text-[26vw] leading-[0.9] font-medium tracking-[-0.05em] whitespace-nowrap">
      {person.displayName}
    </p>
  </footer>
</Base>
