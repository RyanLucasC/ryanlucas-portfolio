---
import { iconFor } from '../lib/icons.mjs';

const { tags } = Astro.props as { tags: string[] };
---

<ul class="flex flex-wrap gap-1.5">
  {
    tags.map((tag) => {
      const icon = iconFor(tag);
      return (
        <li class="flex items-center gap-1.5 bg-edge px-2 py-0.5 text-small text-ink">
          {/* Decorativo: o nome ao lado já diz qual é a tecnologia. */}
          {icon && <img src={icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="size-4 shrink-0" />}
          {tag}
        </li>
      );
    })
  }
</ul>
